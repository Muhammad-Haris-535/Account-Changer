{
  "manifest_version": 3,
  "name": "Account Changer",
  "version": "1.0",
  "permissions": [
    "cookies",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}